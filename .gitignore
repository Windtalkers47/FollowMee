# Root level .gitignore

# Dependencies
node_modules/

# Environment variables
.env
.env.*
!.env.example

# Build directories
/dist
/build

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.idea
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Local development
*.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local Netlify folder
.netlify

# Coverage directory used by testing tools
/coverage
/Backend/coverage/
/Frontend/coverage/

# Generated browser and test output
/playwright-report/
/test-results/

# Disposable local database sandboxes
/mysql-clean-test-*/

# Developer-local artifacts (logs, reports, backups and database sandboxes)
/.local/

# Local database backups may contain customer or authentication data
/Backups/

# Misc
.cache/
.parcel-cache/
.pnp*
