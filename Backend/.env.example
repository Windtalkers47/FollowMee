# FollowMee Backend Configuration
# Copy this file to .env and fill in your values

# ============================================
# Server Configuration
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# Frontend URL (for CORS)
# ============================================
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ============================================
# Database Configuration (MySQL)
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password_here
DB_NAME=followmee
DB_SSL=false
DB_SSL_CA_BASE64=
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=10000
DB_CONNECT_RETRIES=1
DB_RETRY_DELAY_MS=1000

# Rewards sample catalog/missions. Use true only for local development.
# UAT and production must set this to false; redemption stays off until Owner enables it.
REWARD_DEV_SEED=true

# ============================================
# JWT Authentication (REQUIRED)
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
ALLOW_PUBLIC_REGISTRATION=true

# Invitation tokens default to JWT_SECRET when blank. Set a separate value in production.
INVITATION_SECRET=

# Required in production to hash privacy-preserving public-profile analytics.
PROFILE_ANALYTICS_SALT=
PROFILE_LEAD_RATE_LIMIT=8

# Custom profile domains are Owner-managed and disabled until the Phase 3
# migration/configuration has been deployed. Vercel credentials are server-only.
PROFILE_CUSTOM_DOMAINS_ENABLED=false
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ============================================
# Email Configuration (SendGrid - Optional for production)
# For development, emails will use local SMTP fallback
# ============================================
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@followmee.com

# Local SMTP Fallback (optional)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ============================================
# Push Notification Configuration (VAPID Keys)
# Generate keys: Run the app once and check console for generated keys
# Or use: node -e "console.log(require('web-push').generateVAPIDKeys())"
# ============================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=noreply@followmee.com

# ============================================
# Cloudinary Configuration (for image upload)
# Optional - only needed if using image upload feature
# ============================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================
# Runtime security and delivery
# ============================================
CORS_PREVIEW_ORIGINS=
JSON_BODY_LIMIT=6mb
API_RATE_LIMIT_PER_MINUTE=300
ENABLE_API_DOCS=false
