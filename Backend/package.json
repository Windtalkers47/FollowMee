{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --forceExit",
    "test:integration": "jest --config jest.integration.config.ts --runInBand",
    "dev": "nodemon --watch src/**/*.ts --exec ts-node src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typeorm": "typeorm-ts-node-commonjs",
    "watch": "tsc -w",
    "dev:debug": "nodemon --inspect --watch src/**/*.ts --exec ts-node src/server.ts",
    "db:migrate": "ts-node scripts/migrate-db.ts",
    "db:migrate:export": "ts-node scripts/migrate-db.ts export",
    "db:migrate:import": "ts-node scripts/migrate-db.ts import",
    "doctor:db": "ts-node scripts/check-local-db.ts",
    "db:backup": "node scripts/backup-database.cjs",
    "db:restore:drill": "node scripts/restore-drill.cjs",
    "owner:transfer": "ts-node scripts/transfer-owner.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/config/database.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/config/database.ts",
    "migration:run:prod": "typeorm migration:run -d dist/config/database.js",
    "db:schema:verify": "node scripts/verify-clean-schema.cjs",
    "db:explain-work-lists": "node scripts/explain-work-lists.cjs",
    "prod": "npm run build && npm run start"
    ,"start:uat": "node dist/scripts/check-uat-config.js && npm run migration:run:prod && npm run start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.3",
    "@types/supertest": "^6.0.3",
    "express": "^5.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.4",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "chalk": "^4.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "nodemailer": "9.0.3",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "web-push": "^3.6.7"
  }
}
