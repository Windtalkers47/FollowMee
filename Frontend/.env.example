# ===================================
# FollowMee Frontend Environment Variables
# ===================================

# ====== Application Settings ======
VITE_APP_NAME=FollowMee
VITE_NODE_ENV=development

# ========== API Settings ==========
VITE_API_URL=http://localhost:5000/api
VITE_WS_URL=http://localhost:5000

# ======== Auth Settings ===========
VITE_DEFAULT_LOGIN_REDIRECT=/dashboard
VITE_DEFAULT_LOGOUT_REDIRECT=/

# ======== Feature Flags ===========
# Set to 'true' or 'false' to enable/disable features
VITE_FEATURE_REGISTRATION=true
VITE_FEATURE_PASSWORD_RESET=true
VITE_FEATURE_SOCIAL_LOGIN=false

# ====== External Services =========
# Uncomment and configure as needed
# VITE_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
VITE_SENTRY_DSN=your-sentry-dsn
VITE_STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx

# ====== Development Settings ======
# Only for development purposes
VITE_API_MOCK=true
VITE_SHOW_DEV_TOOLS=true

# ====== Security Settings ======
# Encryption Key for request obfuscation (development only)
# Change this to a secure random string
VITE_ENCRYPTION_KEY=your-secret-encryption-key-change-this-in-production
