# ===================================
# FollowMee Frontend Environment Variables
# ===================================

# ====== Application Settings ======
VITE_APP_NAME=FollowMee
VITE_NODE_ENV=development

# ========== API Settings ==========
VITE_API_URL=http://localhost:5000/api
VITE_WS_URL=http://localhost:5000

# ======== Auth Settings ===========
VITE_DEFAULT_LOGIN_REDIRECT=/dashboard
VITE_DEFAULT_LOGOUT_REDIRECT=/
VITE_FEATURE_REGISTRATION=true
VITE_TURNSTILE_SITE_KEY=
VITE_PRIVACY_CONTROLLER_NAME=
VITE_PRIVACY_CONTROLLER_EMAIL=
VITE_PRIVACY_CONTROLLER_ADDRESS=
VITE_PRIVACY_POLICY_EFFECTIVE_DATE=

# ====== Security Settings ======
# Request-obfuscation compatibility key. VITE_* values are public browser data,
# so this is not a secret boundary and must never replace TLS or server-side auth.
VITE_ENCRYPTION_KEY=replace-with-a-non-secret-compatibility-value
