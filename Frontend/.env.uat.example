VITE_APP_NAME=FollowMee UAT
VITE_NODE_ENV=production
VITE_API_URL=https://followmee-backend-uat.example.com/api
VITE_WS_URL=https://followmee-backend-uat.example.com
VITE_DEFAULT_LOGIN_REDIRECT=/my-work
VITE_DEFAULT_LOGOUT_REDIRECT=/
VITE_FEATURE_REGISTRATION=true
VITE_TURNSTILE_SITE_KEY=replace-with-public-site-key
VITE_PRIVACY_CONTROLLER_NAME=replace-with-controller-name
VITE_PRIVACY_CONTROLLER_EMAIL=replace-with-public-contact-email
VITE_PRIVACY_CONTROLLER_ADDRESS=replace-with-contact-address
VITE_PRIVACY_POLICY_EFFECTIVE_DATE=2026-08-25
VITE_ENCRYPTION_KEY=public-compatibility-value
